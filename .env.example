# Copie para .env e preencha. Nunca versione o .env.
AI_PROXY_API_KEY=gw-tok-...

# Slack (agente_slack.py)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_CANAL=#logistica
SLACK_GERENTES=           # IDs de usuário que podem aprovar, separados por vírgula (vazio = qualquer um no canal)
